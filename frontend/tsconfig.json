{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "src/ts",
    "outDir": "../backend/src/main/resources/static/js",
    "noEmitOnError": true
  },
  "include": ["src/ts/**/*.ts"]
}

